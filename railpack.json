{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python -m pip install --upgrade pip",
        "python -m pip install ."
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m uvicorn --app-dir src core.api.asgi_app:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}

# ============================================================
# Test environment — remote API simulation
# Copy to .env.test and configure for your target
# Do NOT commit .env.test (local-only file)
# ============================================================

# Remote API target (Railway/local/staging)
GATEWAY_URL=https://dogestonia-tallinn.up.railway.app

# Service token used by Authorization: Bearer (service layer — stash)
GATEWAY_API_TOKEN=your-service-token-here

# Demo user auth for submit (Supabase password grant → access_token in-memory)
# Account must already be phone_verified in SPA (fail-closed on submit 403)
GATEWAY_USER_EMAIL=your-demo-user@example.com
GATEWAY_USER_PASSWORD=your-demo-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Simulation canvas path (relative to repository root)
SIMULATION_CANVAS_PATH=tests/sandbox/dogestonia_simulation_canvas_v0_1.json
# Clustering demo (≥8/cluster, GW-SEED-02): use v0_2 instead:
# SIMULATION_CANVAS_PATH=tests/sandbox/dogestonia_simulation_canvas_v0_2.json

# Optional group filter (empty = all)
# Values: infrastructure,environment,digital,conflict
SIMULATION_GROUPS=

# Optional max stories per run (empty = all)
SIMULATION_MAX_STORIES=

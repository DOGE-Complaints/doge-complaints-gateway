# ============================================================
# Test environment — remote API simulation
# Copy to .env.test and configure for your target
# Do NOT commit .env.test (local-only file)
# ============================================================

# Remote API target (Railway/local/staging)
GATEWAY_URL=https://dogestonia-tallinn.up.railway.app

# API token used by x-api-token header
GATEWAY_API_TOKEN=your-token-here

# Simulation canvas path (relative to repository root)
SIMULATION_CANVAS_PATH=tests/sandbox/dogestonia_simulation_canvas_v0_1.json

# Optional group filter (empty = all)
# Values: infrastructure,environment,digital,conflict
SIMULATION_GROUPS=

# Optional max stories per run (empty = all)
SIMULATION_MAX_STORIES=

{
  "schema_id": "mobility_observation",
  "schema_version": "v1",
  "payload_schema": "payload.schema.json",
  "field_policy": {
    "route_id": "required",
    "vehicle": "optional",
    "internal_tracker": "forbidden"
  },
  "exact_lenses": [
    {
      "lens_id": "route",
      "source_fields": ["route_id"],
      "algorithm": "exact",
      "scope": "node",
      "scale": "micro",
      "missing_value_policy": "skip",
      "min_size": 4,
      "version": "v1",
      "readiness_policy": {
        "min_readiness_score": 25,
        "min_stories": 4,
        "require_actionable_canonical_type": false
      }
    }
  ]
}

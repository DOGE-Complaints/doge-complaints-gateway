# =============================================================================
# DOGE Complaints Gateway — example environment (greenfield core)
# Copy to `.env` locally. Do not commit real secrets.
# Контракт переменных согласован с `docs/03-supabase-functionality-audit.md` и
# целевой схемой PostgreSQL/Supabase в `docs/solution architecture/03-target-architecture-overview.md`.
# =============================================================================

# --- Supabase (Postgres + HTTP API) ---
# Project URL: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Service role key (secret): только сервер/CI. Полный доступ через PostgREST.
# В коде часто именуется SUPABASE_SERVICE_ROLE (не путать с legacy SUPABASE_KEY).
SUPABASE_SERVICE_ROLE=

# Публичный anon key: для клиентских сценариев; API-шлюз в demo обычно использует service role на сервере.
SUPABASE_ANON_KEY=

# Секрет для проверки JWT Supabase Auth (локальные тесты, edge, отладка).
# Может фигурировать в legacy-скриптах как SUPABASE_JWT_SECRET1 — выровняйте с деплоем.
SUPABASE_JWT_SECRET=

# Прямое подключение к Postgres (опционально): миграции, pg_dump, обход PostgREST.
# Формат: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# DB runtime backend:
# - in_memory (default): текущий demo режим без SQL persistence
# - sqlite: локальная SQL persistence (удобно для dev/e2e)
# - supabase: целевой Supabase/Postgres режим
DB_BACKEND=in_memory
# ВАЖНО: при in_memory не задавайте DATABASE_URL/SUPABASE_URL/SUPABASE_SERVICE_ROLE.

# Для sqlite режима:
# DATABASE_URL=sqlite:////absolute/path/to/doge_gateway.db
# Не задавать SUPABASE_URL/SUPABASE_SERVICE_ROLE.

# Для supabase режима:
# DB_BACKEND=supabase
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE=<service-role-key>

# --- Story-first cluster runtime knobs ---
# Минимальный размер кластера для promotion gate.
CLUSTER_MIN_SIZE=8

# Порог readiness score (1..100).
CLUSTER_READINESS_THRESHOLD=70

# Активные линзы кластеризации (comma-separated):
# topic_micro, need_local, failure_systemic, failure_micro, repeatability_local, relevance_systemic
CLUSTER_ACTIVE_LENSES=topic_micro,need_local,failure_systemic,failure_micro,repeatability_local,relevance_systemic

# Дополнительные policy toggles для алгоритма и будущей per-node конфигурации.
CLUSTER_GEO_FILTER=any
CLUSTER_TIE_BREAKER=lexical
CLUSTER_TYPE_RESOLUTION=canonical_priority

# --- Приложение / профиль среды (дополнять по мере появления core.config) ---
# ENVIRONMENT=development
# LOG_LEVEL=info

# =============================================================================
# DOGE Complaints Gateway — example environment (greenfield core)
# Copy to `.env` locally. Do not commit real secrets.
# Контракт переменных согласован с `docs/03-supabase-functionality-audit.md` и
# целевой схемой PostgreSQL/Supabase в `docs/solution architecture/03-target-architecture-overview.md`.
# =============================================================================

# --- Supabase (Postgres + HTTP API) ---
# Project URL: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Service role key (secret): только сервер/CI. Полный доступ через PostgREST.
# В коде часто именуется SUPABASE_SERVICE_ROLE (не путать с legacy SUPABASE_KEY).
SUPABASE_SERVICE_ROLE=

# Публичный anon key: для клиентских сценариев; API-шлюз в demo обычно использует service role на сервере.
SUPABASE_ANON_KEY=

# Секрет для проверки JWT Supabase Auth (локальные тесты, edge, отладка).
# Может фигурировать в legacy-скриптах как SUPABASE_JWT_SECRET1 — выровняйте с деплоем.
SUPABASE_JWT_SECRET=

# Прямое подключение к Postgres (опционально): миграции, pg_dump, обход PostgREST.
# Формат: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# --- Приложение / профиль среды (дополнять по мере появления core.config) ---
# ENVIRONMENT=development
# LOG_LEVEL=info
